{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kos-notice-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "routes": [
    {
      "pattern": "webdata.kosbackenddata.com/*",
      "zone_name": "kosbackenddata.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "NOTICES_DB",
      "database_name": "kos-notices",
      "database_id": "979757bd-75ce-4f5c-b59a-374bc548c4c0"
    }
  ],
  "observability": {
    "enabled": true
  }
}
